# 서버 포트 (선택, 기본 4000)
PORT=4000

# PostgreSQL — 본인 PC / Docker 값으로 수정하세요
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_DATABASE=admatch

# true면 TypeORM이 테이블을 자동 생성·변경합니다. 운영에서는 false 권장
DB_SYNC=true

# JWT 서명용 비밀값 (긴 임의 문자열로 바꾸세요)
JWT_SECRET=change_this_to_a_long_random_secret
